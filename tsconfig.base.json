{
  "$schema": "./node_modules/typescript/lib/typescript.json",
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "paths": {
      "@recipereel/api-types": ["./packages/api-types/src/index.ts"]
    }
  }
}
